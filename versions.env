# Versiones fijadas del laboratorio (fuente única; RNF-01 Reproducibilidad).
# Consultadas el 12/10/2026. Ver docs/adr/0002 para la justificación de kind y Kubernetes 1.35.
# Formato KEY=VALUE compatible con shell y Make.

# kind CLI: misma versión de librería que embebe el provider tehcyx/kind v0.11.0 (kind v0.31.0).
KIND_VERSION=v0.31.0
# Imagen de nodo publicada con kind v0.31.0 (digest fijado).
KIND_NODE_IMAGE=kindest/node:v1.35.0@sha256:452d707d4862f52530247495d180205e029056831160e22870e37e3f6c1ac31f
# kubectl: dentro del version skew soportado (±1 minor respecto al API server 1.35).
KUBECTL_VERSION=v1.35.9
HELM_VERSION=v4.3.0
TERRAFORM_VERSION=1.16.5
SHELLCHECK_VERSION=v0.11.0
# El proyecto ShellCheck no publica fichero de checksums; hash calculado y fijado al incorporar la versión.
SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198

# Charts de Helm (consultados el 12/10/2026).
# argo-cd y argocd-apps los instala Terraform (infra/terraform/bootstrap, ADR-0003).
# argo-cd 10.10.3 = Argo CD v3.5.5.
ARGOCD_CHART_VERSION=10.10.3
ARGOCD_APPS_CHART_VERSION=2.0.6
# El de Traefik lo instala Argo CD: la versión efectiva está en gitops/platform/apps/traefik.yaml
# y `make check` comprueba que coincide con esta. traefik 41.7.1 = Traefik v3.7.14.
TRAEFIK_CHART_VERSION=41.7.1
