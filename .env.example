# Copiar a .env (excluido de Git) y ajustar. Ningún valor real debe versionarse (RNF-04).

# Nombre del clúster kind y del contexto kubectl resultante (kind-<nombre>).
LAB_CLUSTER_NAME=idp-lab

# Puertos del host mapeados al nodo kind para el ingress (fase S5).
LAB_HTTP_PORT=80
LAB_HTTPS_PORT=443

# Dominio base de los servicios del laboratorio. *.localtest.me resuelve a 127.0.0.1
# sin editar /etc/hosts.
LAB_DOMAIN=localtest.me

# --- Fases posteriores (no necesarias en S3) ---
# Token de GitHub para Backstage (integración y plantillas). Nunca en el repositorio.
# GITHUB_TOKEN=
